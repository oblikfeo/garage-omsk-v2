# Production domain for SEO metadata, sitemap and Open Graph.
# On Vercel this is set automatically from VERCEL_URL if omitted.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Password for the admin panel at /admin.
# The panel refuses every login until this is set on the server.
ADMIN_PASSWORD=

# Optional. Secret used to sign admin session cookies.
# Defaults to a value derived from ADMIN_PASSWORD, which means changing the
# password also signs everyone out.
ADMIN_SESSION_SECRET=

# Optional. Writable directory holding content.json edited through the panel.
# Defaults to ./data next to the build.
CONTENT_DIR=

# Optional. Writable directory for photos uploaded through the panel.
# Defaults to ./public/uploads
UPLOAD_DIR=
